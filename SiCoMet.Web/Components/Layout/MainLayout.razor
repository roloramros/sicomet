@inherits LayoutComponentBase
@using System.Security.Claims
@using SiCoMet.Web.Data

<AuthorizeView>
    <Authorized Context="authContext">
        <div class="app-shell">
            <aside class="sidebar">
                <header class="sidebar-header">
                    <div class="brand-icon" aria-hidden="true">S</div>
                    <div class="brand-text">
                        <strong>SiCoMet</strong>
                        <span>Sistema de Control de Metrología</span>
                    </div>
                </header>

                <nav class="sidebar-body" aria-label="Navegación principal">
                    <div class="nav-section">
                        <div class="nav-section-title">Principal</div>
                        <NavLink href="/dashboard" class="nav-item" Match="NavLinkMatch.All">
                            <span class="nav-icon">⌂</span>
                            <span>Inicio</span>
                        </NavLink>
                    </div>

                    <AuthorizeView Roles="@Roles.Administrador">
                        <Authorized>
                            <div class="nav-section">
                                <div class="nav-section-title">Administración</div>
                                <NavLink href="/usuarios" class="nav-item">
                                    <span class="nav-icon">👥</span>
                                    <span>Usuarios</span>
                                </NavLink>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </nav>

                <footer class="sidebar-footer">
                    <div class="user-info">
                        <div class="user-avatar" aria-hidden="true">@InicialUsuario(authContext.User)</div>
                        <div class="user-details">
                            <strong>@NombreUsuario(authContext.User)</strong>
                            <span>@authContext.User.Identity?.Name</span>
                            <span class="user-role">@RolUsuario(authContext.User)</span>
                        </div>
                    </div>

                    <form action="Account/Logout" method="post" class="logout-form">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="logout-button">Cerrar sesión</button>
                    </form>
                </footer>
            </aside>

            <main class="main-content">
                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="anonymous-page">
            @Body
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    Ha ocurrido un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private string NombreUsuario(ClaimsPrincipal user)
    {
        var nombre = user.FindFirst("NombreCompleto")?.Value;
        return string.IsNullOrWhiteSpace(nombre) ? (user.Identity?.Name ?? "Usuario") : nombre;
    }

    private string RolUsuario(ClaimsPrincipal user)
    {
        var roles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
        return roles.Count > 0 ? string.Join(", ", roles) : "Sin rol";
    }

    private string InicialUsuario(ClaimsPrincipal user)
    {
        var nombre = NombreUsuario(user);
        return string.IsNullOrWhiteSpace(nombre) ? "U" : nombre.Trim()[0].ToString().ToUpperInvariant();
    }
}
