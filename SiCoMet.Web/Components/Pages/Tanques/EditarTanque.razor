@page "/tanques/editar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Editar tanque</PageTitle>

<div class="page-container">
    <a href="/tanques" class="back-link">← Volver a tanques</a>
    <h1>Editar tanque</h1>

    @if (tanque is null)
    {
        <p>Cargando...</p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="GuardarCambios" FormName="editar-tanque">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="form-group mb-3">
                <label>Número del tanque</label>
                <InputText @bind-Value="Input.Numero" class="form-control" />
                <ValidationMessage For="() => Input.Numero" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label>Producto</label>
                <InputSelect @bind-Value="Input.ProductoId" class="form-control">
                    <option value="">-- Sin producto --</option>
                    @foreach (var p in productos)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </InputSelect>
            </div>

            <h2 class="h5 mt-4">Dimensiones (metros)</h2>

            <div class="form-group mb-3">
                <label>Altura de referencia</label>
                <InputText @bind-Value="Input.AlturaReferencia" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Diámetro nominal</label>
                <InputText @bind-Value="Input.DiametroNominal" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura operacional</label>
                <InputText @bind-Value="Input.AlturaOperacional" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura de máximo llenado</label>
                <InputText @bind-Value="Input.AlturaMaximoLlenado" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura de fondaje</label>
                <InputText @bind-Value="Input.AlturaFondaje" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura de la platina de medición</label>
                <InputText @bind-Value="Input.AlturaPlatinaMedicion" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura de la corona del cono del fondo (si el fondo tiene corona)</label>
                <InputText @bind-Value="Input.AlturaCoronaConoFondo" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Altura total de la pared</label>
                <InputText @bind-Value="Input.AlturaTotalPared" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <h2 class="h5 mt-4">Construcción</h2>

            <div class="form-group mb-3">
                <label>Tipo de fondo</label>
                <InputSelect @bind-Value="Input.TipoFondo" class="form-control">
                    <option value="">-- Sin especificar --</option>
                    <option value="Plano">Plano</option>
                    <option value="CoronaArriba">Corona arriba</option>
                    <option value="CoronaAbajo">Corona abajo</option>
                </InputSelect>
            </div>

            <div class="form-group mb-3">
                <label>Tipo de techo</label>
                <InputSelect @bind-Value="Input.TipoTecho" class="form-control">
                    <option value="">-- Sin especificar --</option>
                    <option value="Fijo">Fijo</option>
                    <option value="Flotante">Flotante</option>
                </InputSelect>
            </div>

            <div class="form-group mb-3">
                <label>Masa del techo flotante (kg) — solo si el techo es flotante</label>
                <InputText @bind-Value="Input.MasaTechoFlotante" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Cantidad de rolos</label>
                <InputText @bind-Value="Input.CantidadRolos" type="number" step="1" min="0" inputmode="numeric" class="form-control" />
            </div>

            <h2 class="h5 mt-4">Calibración y aforo</h2>

            <div class="form-group mb-3">
                <label>Factor de volumen</label>
                <InputText @bind-Value="Input.FactorVolumen" type="number" step="any" min="0" inputmode="decimal" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Fecha de última calibración</label>
                <InputText @bind-Value="Input.FechaUltimaCalibracion" type="date" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label>Número del certificado de aforo</label>
                <InputText @bind-Value="Input.NumeroCertificadoAforo" class="form-control" />
                <ValidationMessage For="() => Input.NumeroCertificadoAforo" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label>Entidad que realizó el aforo</label>
                <InputText @bind-Value="Input.EntidadAforo" class="form-control" />
                <ValidationMessage For="() => Input.EntidadAforo" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label>Vigencia del certificado</label>
                <InputText @bind-Value="Input.VigenciaCertificado" type="date" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/tanques" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Tanque? tanque;
    private string? errorMessage;
    private List<Producto> productos = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private TanqueInput Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        tanque = await DbContext.Tanques.FindAsync(Id);

        // Productos activos, más el producto actual del tanque aunque esté inactivo
        var productoActualId = tanque?.ProductoId;
        productos = await DbContext.Productos
            .Where(p => p.Activo || p.Id == productoActualId)
            .OrderBy(p => p.Nombre)
            .ToListAsync();

        if (tanque is not null && HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input = TanqueInput.Desde(tanque);
        }
    }

    private async Task GuardarCambios()
    {
        errorMessage = null;

        if (tanque is null)
        {
            return;
        }

        var numero = Input.Numero.Trim();
        var existe = await DbContext.Tanques.AnyAsync(t => t.Numero == numero && t.Id != tanque.Id);
        if (existe)
        {
            errorMessage = "Ya existe otro tanque con ese número.";
            return;
        }

        if (!Input.TryAplicar(tanque, out var error))
        {
            errorMessage = error;
            return;
        }

        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("Tanque", TipoAccionAuditoria.Editar,
            $"Se editó el tanque '{tanque.Numero}'.");

        NavigationManager.NavigateTo("/tanques?Mensaje=Tanque actualizado correctamente", forceLoad: true);
    }
}
