@page "/tanques/eliminar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Eliminar tanque</PageTitle>

<div class="page-container">
    <a href="/tanques" class="back-link">← Volver a tanques</a>
    <h1>Eliminar tanque</h1>

    @if (tanque is null)
    {
        <div class="alert alert-warning">El tanque no existe.</div>
    }
    else
    {
        <div class="alert alert-warning">
            ¿Seguro que deseas eliminar el tanque <strong>@tanque.Numero</strong>?
            Esta acción no se puede deshacer.
        </div>

        <EditForm Model="Confirmacion" OnValidSubmit="Eliminar" FormName="eliminar-tanque">
            <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
            <a href="/tanques" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Tanque? tanque;
    private ConfirmacionModel Confirmacion { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        tanque = await DbContext.Tanques.FindAsync(Id);
    }

    private async Task Eliminar()
    {
        if (tanque is null)
        {
            return;
        }

        DbContext.Tanques.Remove(tanque);
        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("Tanque", TipoAccionAuditoria.Eliminar,
            $"Se eliminó el tanque '{tanque.Numero}'.");

        NavigationManager.NavigateTo("/tanques?Mensaje=Tanque eliminado correctamente", forceLoad: true);
    }

    private sealed class ConfirmacionModel
    {
    }
}
