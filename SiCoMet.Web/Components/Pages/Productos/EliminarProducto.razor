@page "/productos/eliminar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Eliminar producto</PageTitle>

<div class="page-container">
    <a href="/productos" class="back-link">← Volver a productos</a>
    <h1>Eliminar producto</h1>

    @if (producto is null)
    {
        <div class="alert alert-warning">El producto no existe.</div>
    }
    else if (cantidadTanques > 0)
    {
        <div class="alert alert-danger">
            No se puede eliminar el producto <strong>@producto.Nombre</strong> porque tiene
            @cantidadTanques tanque(s) asociado(s). Reasigna esos tanques o márcalo como
            inactivo en su lugar.
        </div>
        <a href="/productos" class="btn btn-outline-secondary">Volver</a>
    }
    else
    {
        <div class="alert alert-warning">
            ¿Seguro que deseas eliminar el producto <strong>@producto.Nombre</strong>?
            Esta acción no se puede deshacer.
        </div>

        <EditForm Model="Confirmacion" OnValidSubmit="Eliminar" FormName="eliminar-producto">
            <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
            <a href="/productos" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Producto? producto;
    private int cantidadTanques;
    private ConfirmacionModel Confirmacion { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        producto = await DbContext.Productos.FindAsync(Id);
        if (producto is not null)
        {
            cantidadTanques = await DbContext.Tanques.CountAsync(t => t.ProductoId == producto.Id);
        }
    }

    private async Task Eliminar()
    {
        if (producto is null || cantidadTanques > 0)
        {
            return;
        }

        DbContext.Productos.Remove(producto);
        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("Producto", TipoAccionAuditoria.Eliminar,
            $"Se eliminó el producto '{producto.Nombre}'.");

        NavigationManager.NavigateTo("/productos?Mensaje=Producto eliminado correctamente", forceLoad: true);
    }

    private sealed class ConfirmacionModel
    {
    }
}
