@page "/productos/editar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Editar producto</PageTitle>

<div class="page-container">
    <a href="/productos" class="back-link">← Volver a productos</a>
    <h1>Editar producto</h1>

    @if (producto is null)
    {
        <p>Cargando...</p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="GuardarCambios" FormName="editar-producto">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="form-group mb-3">
                <label>Nombre</label>
                <InputText @bind-Value="Input.Nombre" class="form-control" />
                <ValidationMessage For="() => Input.Nombre" class="text-danger" />
            </div>

            <div class="form-group mb-3 form-check">
                <InputCheckbox @bind-Value="Input.Activo" class="form-check-input" id="activoCheck" />
                <label class="form-check-label" for="activoCheck">Producto activo</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/productos" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Producto? producto;
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        producto = await DbContext.Productos.FindAsync(Id);

        if (producto is not null && HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input = new InputModel
            {
                Nombre = producto.Nombre,
                Activo = producto.Activo
            };
        }
    }

    private async Task GuardarCambios()
    {
        errorMessage = null;

        if (producto is null)
        {
            return;
        }

        var existe = await DbContext.Productos.AnyAsync(p => p.Nombre == Input.Nombre && p.Id != producto.Id);
        if (existe)
        {
            errorMessage = "Ya existe otro producto con ese nombre.";
            return;
        }

        producto.Nombre = Input.Nombre;
        producto.Activo = Input.Activo;
        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("Producto", TipoAccionAuditoria.Editar,
            $"Se editó el producto '{producto.Nombre}'.");

        NavigationManager.NavigateTo("/productos?Mensaje=Producto actualizado correctamente", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(100)]
        public string Nombre { get; set; } = "";

        public bool Activo { get; set; } = true;
    }
}
