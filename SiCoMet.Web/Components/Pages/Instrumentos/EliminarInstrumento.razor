@page "/instrumentos/eliminar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Eliminar instrumento</PageTitle>

<div class="page-container">
    <a href="/instrumentos" class="back-link">← Volver a instrumentos</a>
    <h1>Eliminar instrumento</h1>

    @if (instrumento is null)
    {
        <div class="alert alert-warning">El instrumento no existe.</div>
    }
    else if (cantidadCalibraciones > 0)
    {
        <div class="alert alert-danger">
            No se puede eliminar el instrumento con serie <strong>@instrumento.Serie</strong> porque
            tiene @cantidadCalibraciones calibración(es) registrada(s) en su historial.
            Si ya no está en uso, marcalo como <strong>inactivo</strong> desde la edición en vez de eliminarlo.
        </div>
        <a href="/instrumentos" class="btn btn-outline-secondary">Volver</a>
    }
    else
    {
        <div class="alert alert-warning">
            ¿Seguro que deseas eliminar el instrumento con serie <strong>@instrumento.Serie</strong>?
            Esta acción no se puede deshacer.
        </div>

        <EditForm Model="Confirmacion" OnValidSubmit="Eliminar" FormName="eliminar-instrumento">
            <button type="submit" class="btn btn-danger">Eliminar definitivamente</button>
            <a href="/instrumentos" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private Instrumento? instrumento;
    private int cantidadCalibraciones;
    private ConfirmacionModel Confirmacion { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        instrumento = await DbContext.Instrumentos.FindAsync(Id);
        if (instrumento is not null)
        {
            cantidadCalibraciones = await DbContext.Calibraciones.CountAsync(c => c.InstrumentoId == instrumento.Id);
        }
    }

    private async Task Eliminar()
    {
        if (instrumento is null || cantidadCalibraciones > 0)
        {
            return;
        }

        DbContext.Instrumentos.Remove(instrumento);
        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("Instrumento", TipoAccionAuditoria.Eliminar,
            $"Se eliminó el instrumento con serie '{instrumento.Serie}'.");

        NavigationManager.NavigateTo("/instrumentos?Mensaje=Instrumento eliminado correctamente", forceLoad: true);
    }

    private sealed class ConfirmacionModel
    {
    }
}
