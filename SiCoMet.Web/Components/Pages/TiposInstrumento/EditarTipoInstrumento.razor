@page "/tipos-instrumento/editar/{Id:int}"
@attribute [Authorize(Roles = Roles.Administrador)]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject NavigationManager NavigationManager

<PageTitle>SiCoMet - Editar tipo de instrumento</PageTitle>

<div class="page-container">
    <a href="/tipos-instrumento" class="back-link">← Volver a tipos de instrumento</a>
    <h1>Editar tipo de instrumento</h1>

    @if (tipo is null)
    {
        <p>Cargando...</p>
    }
    else
    {
        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" OnValidSubmit="GuardarCambios" FormName="editar-tipo-instrumento">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="form-group mb-3">
                <label>Nombre</label>
                <InputText @bind-Value="Input.Nombre" class="form-control" />
                <ValidationMessage For="() => Input.Nombre" class="text-danger" />
            </div>

            <div class="form-group mb-3">
                <label>Unidad de medida</label>
                <InputText @bind-Value="Input.UnidadMedida" class="form-control" />
                <ValidationMessage For="() => Input.UnidadMedida" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/tipos-instrumento" class="btn btn-outline-secondary">Cancelar</a>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private TipoInstrumento? tipo;
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        tipo = await DbContext.TiposInstrumento.FindAsync(Id);

        if (tipo is not null && HttpMethods.IsGet(HttpContext.Request.Method))
        {
            Input = new InputModel
            {
                Nombre = tipo.Nombre,
                UnidadMedida = tipo.UnidadMedida
            };
        }
    }

    private async Task GuardarCambios()
    {
        errorMessage = null;

        if (tipo is null)
        {
            return;
        }

        var existe = await DbContext.TiposInstrumento.AnyAsync(t => t.Nombre == Input.Nombre && t.Id != tipo.Id);
        if (existe)
        {
            errorMessage = "Ya existe otro tipo de instrumento con ese nombre.";
            return;
        }

        tipo.Nombre = Input.Nombre;
        tipo.UnidadMedida = Input.UnidadMedida;
        await DbContext.SaveChangesAsync();

        await Auditoria.RegistrarAsync("TipoInstrumento", TipoAccionAuditoria.Editar,
            $"Se editó el tipo de instrumento '{tipo.Nombre}'.");

        NavigationManager.NavigateTo("/tipos-instrumento?Mensaje=Tipo de instrumento actualizado correctamente", forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(150)]
        public string Nombre { get; set; } = "";

        [MaxLength(50)]
        public string? UnidadMedida { get; set; }
    }
}
