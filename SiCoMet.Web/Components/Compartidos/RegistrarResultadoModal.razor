@using Microsoft.EntityFrameworkCore
@using SiCoMet.Web.Data
@inject ApplicationDbContext DbContext
@inject IAuditoriaService Auditoria
@inject CertificadoService Certificados

@* Formulario "Registrar resultado" de una calibración que está en el taller. Lo usan el
   panel de calibración y el plan mensual. El componente solo existe mientras el modal está
   abierto: quien lo usa lo muestra con un @if y lo cierra al recibir OnCerrar, OnRegistrado
   u OnConflicto. *@

<div class="modal-fondo" style="position:fixed;inset:0;z-index:2000;display:flex;align-items:flex-start;justify-content:center;padding:2rem 1rem;overflow-y:auto;background:rgba(0,0,0,.45)">
    <div class="modal-caja" style="width:100%;max-width:540px;padding:1.25rem 1.5rem;background:#fff;border-radius:8px" role="dialog" aria-modal="true" aria-labelledby="titulo-resultado">
        <h2 id="titulo-resultado">Registrar resultado</h2>

        <p class="mb-3">
            <strong>@Instrumento.Serie</strong> · @Instrumento.TipoInstrumento.Nombre · @Instrumento.Area.Nombre<br />
            <span class="text-muted">Enviado el @(CalibracionAbierta.FechaEnvioTaller.ToString("dd/MM/yyyy"))</span>
        </p>

        @if (errores.Count > 0)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var e in errores)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        }

        <div class="form-group mb-3">
            <label>Fecha de calibración</label>
            <input type="date" class="form-control" @bind="resFechaCalibracion" @bind:format="yyyy-MM-dd" @bind:after="RecalcularProxima" max="@HoyIso" />
        </div>

        <div class="form-group mb-3">
            <label>Próxima calibración</label>
            <input type="date" class="form-control" @bind="resFechaProxima" @bind:format="yyyy-MM-dd" @bind:after="MarcarProximaEditada" />
            <div class="form-text">
                @if (Instrumento.PeriodicidadMeses > 0)
                {
                    <span>Se calcula con la periodicidad del instrumento (@Instrumento.PeriodicidadMeses meses); puede modificarla.</span>
                }
                else
                {
                    <span>El instrumento no tiene periodicidad definida; indique la fecha manualmente.</span>
                }
            </div>
        </div>

        <div class="form-group mb-3">
            <label>Estado técnico</label>
            <select class="form-control" @bind="resEstado">
                <option value="@EstadoTecnico.DentroDeLimites">Dentro de límites</option>
                <option value="@EstadoTecnico.NoApto">No apto</option>
            </select>
        </div>

        @if (resEstado == EstadoTecnico.NoApto)
        {
            <div class="form-group mb-3">
                <label>Motivo de no conformidad</label>
                <textarea class="form-control" rows="2" maxlength="500" @bind="resMotivo" @bind:event="oninput"></textarea>
            </div>
        }

        <div class="form-group mb-3">
            <label>Número de certificado (opcional)</label>
            <input type="text" class="form-control" maxlength="100" @bind="resCertificado" @bind:event="oninput" />
        </div>

        <div class="form-group mb-3">
            <label>Certificado de calibración en PDF (opcional)</label>
            <InputFile class="form-control" accept=".pdf,application/pdf" OnChange="SeleccionarCertificado" />
            @if (resArchivoError is not null)
            {
                <div class="form-text text-danger">@resArchivoError</div>
            }
            else if (resArchivo is not null)
            {
                <div class="form-text">Seleccionado: @resArchivo.Name (@FormatoTamano(resArchivo.Size))</div>
            }
            else
            {
                <div class="form-text">Solo PDF, máximo 10 MB.</div>
            }
        </div>

        <div class="form-group mb-3">
            <label>Observaciones (opcional)</label>
            <textarea class="form-control" rows="2" maxlength="500" @bind="resObservaciones" @bind:event="oninput"></textarea>
        </div>

        <div class="modal-acciones">
            <button type="button" class="btn btn-outline-secondary" @onclick="() => OnCerrar.InvokeAsync()" disabled="@guardando">Cancelar</button>
            <button type="button" class="btn btn-primary" @onclick="ConfirmarResultado" disabled="@guardando">Guardar resultado</button>
        </div>
    </div>
</div>

@code {
    /// <summary>Instrumento al que se le registra el resultado, con su Área y Tipo ya cargados.</summary>
    [Parameter, EditorRequired]
    public Instrumento Instrumento { get; set; } = null!;

    /// <summary>Su calibración abierta (enviada al taller, sin resultado todavía).</summary>
    [Parameter, EditorRequired]
    public Calibracion CalibracionAbierta { get; set; } = null!;

    /// <summary>El usuario canceló.</summary>
    [Parameter]
    public EventCallback OnCerrar { get; set; }

    /// <summary>Se guardó el resultado; recibe el mensaje de éxito para mostrar.</summary>
    [Parameter]
    public EventCallback<string> OnRegistrado { get; set; }

    /// <summary>No se guardó porque la calibración ya no estaba en el taller; recibe el mensaje de error.</summary>
    [Parameter]
    public EventCallback<string> OnConflicto { get; set; }

    private DateOnly hoy;
    private DateOnly? resFechaCalibracion;
    private DateOnly? resFechaProxima;
    private EstadoTecnico resEstado = EstadoTecnico.DentroDeLimites;
    private string? resMotivo;
    private string? resCertificado;
    private string? resObservaciones;
    private IBrowserFile? resArchivo;
    private string? resArchivoError;
    private bool proximaEditada;
    private List<string> errores = new();
    private bool guardando;

    private string HoyIso => hoy.ToString("yyyy-MM-dd");

    protected override void OnInitialized()
    {
        hoy = DateOnly.FromDateTime(DateTime.Today);
        resFechaCalibracion = hoy;
        resObservaciones = CalibracionAbierta.Observaciones;
        RecalcularProxima();
    }

    private void RecalcularProxima()
    {
        if (proximaEditada) return;

        resFechaProxima = resFechaCalibracion is not null && Instrumento.PeriodicidadMeses > 0
            ? resFechaCalibracion.Value.AddMonths(Instrumento.PeriodicidadMeses)
            : null;
    }

    private void MarcarProximaEditada() => proximaEditada = true;

    private void SeleccionarCertificado(InputFileChangeEventArgs e)
    {
        resArchivo = null;
        resArchivoError = CertificadoService.ValidarSeleccion(e.File);
        if (resArchivoError is null) resArchivo = e.File;
    }

    private static string FormatoTamano(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.0} MB" : $"{Math.Max(1, bytes / 1024)} KB";

    private async Task ConfirmarResultado()
    {
        errores.Clear();

        var envio = CalibracionAbierta.FechaEnvioTaller;

        if (resFechaCalibracion is null)
            errores.Add("Indique la fecha de calibración.");
        else if (resFechaCalibracion.Value > hoy)
            errores.Add("La fecha de calibración no puede ser futura.");
        else if (resFechaCalibracion.Value < envio)
            errores.Add($"La fecha de calibración no puede ser anterior al envío ({envio:dd/MM/yyyy}).");

        if (resFechaProxima is null)
            errores.Add("Indique la fecha de la próxima calibración.");
        else if (resFechaCalibracion is not null && resFechaProxima.Value <= resFechaCalibracion.Value)
            errores.Add("La próxima calibración debe ser posterior a la fecha de calibración.");

        if (resEstado == EstadoTecnico.NoApto && string.IsNullOrWhiteSpace(resMotivo))
            errores.Add("Indique el motivo cuando el instrumento no es apto.");

        if ((resMotivo?.Length ?? 0) > 500 || (resObservaciones?.Length ?? 0) > 500)
            errores.Add("El motivo y las observaciones no pueden superar los 500 caracteres.");

        if ((resCertificado?.Length ?? 0) > 100)
            errores.Add("El número de certificado no puede superar los 100 caracteres.");

        if (resArchivoError is not null)
            errores.Add(resArchivoError);

        if (errores.Count > 0) return;

        guardando = true;
        CertificadoGuardado? certificado = null;
        try
        {
            var calibracion = await DbContext.Calibraciones.FirstOrDefaultAsync(c => c.Id == CalibracionAbierta.Id);
            if (calibracion is null || calibracion.FechaCalibracion is not null)
            {
                await OnConflicto.InvokeAsync("Este instrumento ya no está en taller. Se actualizó la lista.");
                return;
            }

            if (resArchivo is not null)
            {
                certificado = await Certificados.GuardarAsync(resArchivo);
                calibracion.CertificadoArchivoNombre = certificado.Nombre;
                calibracion.CertificadoArchivoRuta = certificado.Ruta;
                calibracion.CertificadoArchivoTamano = certificado.Tamano;
                calibracion.CertificadoArchivoFecha = DateTime.UtcNow;
            }

            calibracion.FechaCalibracion = resFechaCalibracion;
            calibracion.FechaProximaCalibracion = resFechaProxima;
            calibracion.EstadoTecnico = resEstado;
            calibracion.MotivoNoApto = resEstado == EstadoTecnico.NoApto ? resMotivo!.Trim() : null;
            calibracion.CertificadoNumero = string.IsNullOrWhiteSpace(resCertificado) ? null : resCertificado.Trim();
            calibracion.Observaciones = string.IsNullOrWhiteSpace(resObservaciones) ? null : resObservaciones.Trim();
            await DbContext.SaveChangesAsync();

            var serie = Instrumento.Serie;
            var resultado = resEstado == EstadoTecnico.NoApto ? "No apto" : "Dentro de límites";
            await Auditoria.RegistrarAsync(
                "Calibración",
                TipoAccionAuditoria.Editar,
                Truncar($"Registró resultado de calibración de {serie}: {resultado}, calibrado el {resFechaCalibracion:dd/MM/yyyy}, próxima {resFechaProxima:dd/MM/yyyy}{(certificado is not null ? ", con certificado PDF" : "")}"));

            await OnRegistrado.InvokeAsync($"Resultado de {serie} registrado ({resultado}).");
        }
        catch (CertificadoInvalidoException ex)
        {
            errores.Add(ex.Message);
        }
        catch (DbUpdateException)
        {
            // Si la base de datos falló, no dejar el PDF huérfano en el disco.
            if (certificado is not null) Certificados.Eliminar(certificado.Ruta);
            errores.Add("No se pudo guardar el resultado. Intente de nuevo.");
        }
        finally
        {
            guardando = false;
        }
    }

    private static string Truncar(string texto) => texto.Length <= 500 ? texto : texto[..497] + "...";
}
